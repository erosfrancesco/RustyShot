{
  "name": "rustyshot",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "format": "prettier --write \"**/*.{ts,js,json,css,html,md}\""
  },
  "devDependencies": {
    "@babylonjs/core": "^5.53.0",
    "@babylonjs/gui": "^5.53.0",
    "@babylonjs/loaders": "^5.53.0",
    "@babylonjs/materials": "^5.53.0",
    "@babylonjs/serializers": "^5.53.0",
    "@eslint/js": "^9.16.0",
    "@types/node": "^22.9.0",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "eslint": "^9.16.0",
    "eslint-config-prettier": "^9.1.0",
    "globals": "^15.13.0",
    "happy-dom": "^17.4.4",
    "prettier": "^3.4.2",
    "typescript": "^5.6.3",
    "vite": "^6.0.5",
    "vitest": "^3.0.4"
  }
}
